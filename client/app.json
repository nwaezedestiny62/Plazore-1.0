{
  "expo": {
    "name": "Plazore",
    "slug": "Plazore",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-0.png",
    "scheme": "plazore",
    "userInterfaceStyle": "dark",
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#090B0F",
      "translucent": false
    },
    "ios": {
      "supportsTablet": true,
      "userInterfaceStyle": "dark",
      "icon": "./assets/logo-0.png",
      "bundleIdentifier": "com.plazore.app",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "com.plazore.app",
      "versionCode": 1,
      "userInterfaceStyle": "dark",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-0.png",
        "backgroundColor": "#090B0F"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/logo-0.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-0.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#090B0F",
          "dark": {
            "image": "./assets/logo-0.png",
            "backgroundColor": "#090B0F"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logo-0.png",
          "color": "#090B0F",
          "defaultChannel": "plazore_default",
          "sounds": []
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "94719469-9dc2-4ee9-9e38-8a25dd04b14d"
      }
    }
  }
}
